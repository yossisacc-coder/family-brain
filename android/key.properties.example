# Copy this file to android/key.properties and fill in REAL values locally.
# Do not commit android/key.properties, *.jks, or *.keystore.
#
# MANUAL SETUP REQUIRED — generate an upload keystore before a Play AAB:
#   keytool -genkey -v -keystore android/upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
#
# storeFile is relative to android/app/.

storePassword=REPLACE_ME
keyPassword=REPLACE_ME
keyAlias=upload
storeFile=../upload-keystore.jks
