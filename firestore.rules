rules_version = '2';
// Deploy this file to the real Firebase project before production.
// MANUAL SETUP REQUIRED: firebase deploy --only firestore:rules
// Do not invent a project ID here.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function sameFamily(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).familyId == familyId;
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId ||
         (resource.data.familyId != null &&
          userDoc(request.auth.uid).familyId == resource.data.familyId));
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read: if sameFamily(familyId);
      allow create: if signedIn();
      allow update: if sameFamily(familyId) ||
        (signedIn() && request.resource.data.inviteCode == resource.data.inviteCode);
    }

    match /tasks/{taskId} {
      allow read, write: if sameFamily(resource.data.familyId) ||
        (request.resource.data.familyId != null &&
         sameFamily(request.resource.data.familyId));
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }

    function ownerOrAdmin(familyId) {
      return sameFamily(familyId) &&
        (userDoc(request.auth.uid).familyRole in ['owner', 'admin'] ||
         get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid);
    }

    match /activity/{activityId} {
      allow read: if signedIn() &&
        sameFamily(resource.data.familyId) &&
        (resource.data.personal != true ||
         resource.data.actorId == request.auth.uid ||
         resource.data.assigneeId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.familyId != null &&
        sameFamily(request.resource.data.familyId);
      allow delete: if signedIn() &&
        sameFamily(resource.data.familyId) &&
        (resource.data.actorId == request.auth.uid ||
         ownerOrAdmin(resource.data.familyId));
      allow update: if false;
    }
  }
}
